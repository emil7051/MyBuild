# Backend environment variables
PROJECT_NAME="TCO Web Platform API"
ENVIRONMENT="development"
API_V1_PREFIX="/api/v1"
# CORS origins (comma-separated for multiple origins)
# Development: http://localhost:5000
# Production: Usually not needed as frontend is served by same app
BACKEND_CORS_ORIGINS="http://localhost:5000,http://127.0.0.1:5000"
# Database URL
# SQLite (development): sqlite+aiosqlite:///./tco.db
# PostgreSQL: postgresql+asyncpg://user:password@host/dbname
# Note: SSL parameters (sslmode, ssl) are automatically removed for asyncpg compatibility
DATABASE_URL="sqlite+aiosqlite:///./tco.db"
REDIS_URL="redis://localhost:6379/0"
# Optional dedicated Redis for distributed rate limiting.
# Defaults to REDIS_URL outside development if unset.
RATE_LIMIT_REDIS_URL=""
# Emergency override only. Keep false unless you intentionally accept degraded
# rate-limiter guarantees in non-development environments.
ALLOW_INSECURE_RATE_LIMITER="false"
SESSION_TTL_SECONDS="1800"
# Analytics endpoint key (required for /api/v1/analytics/summary)
ANALYTICS_API_KEY="change-me"
