# Production environment variables
# Copy this to backend/.env in production and fill in actual values

PROJECT_NAME="TCO Web Platform API"
ENVIRONMENT="production"
API_V1_PREFIX="/api/v1"
BACKEND_CORS_ORIGINS="https://your-app.replit.app"

# Database - Use your production Postgres database URL
DATABASE_URL="postgresql+asyncpg://user:password@host/database"

# Redis - Use your production Redis URL  
REDIS_URL="redis://host:6379/0"
# Optional dedicated Redis for distributed rate limiting. If unset, REDIS_URL is used.
RATE_LIMIT_REDIS_URL=""
# Emergency override only. Keep false in production.
ALLOW_INSECURE_RATE_LIMITER="false"

SESSION_TTL_SECONDS="1800"
