# Production environment variables
# Copy this to backend/.env in production and fill in actual values

PROJECT_NAME="TCO Web Platform API"
ENVIRONMENT="production"
API_V1_PREFIX="/api/v1"
BACKEND_CORS_ORIGINS="https://your-app.replit.app"
CACHE_RESULTS="true"

# Database - Use your production Postgres database URL
DATABASE_URL="postgresql+asyncpg://user:password@host/database"

# Redis - Use your production Redis URL  
REDIS_URL="redis://host:6379/0"

SESSION_TTL_SECONDS="1800"
